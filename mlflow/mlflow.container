[Unit]
Description=Freva MLflow
Documentation=https://github.com/freva-org/freva-service-config/tree/main/mlflow
Wants=network-online.target
After=network-online.target
Before=nginx.service


[Container]
# Pin the deployed version per host with a drop-in instead of editing this
# file, see "Pin the MLflow version" in README.md:
#
#   /etc/containers/systemd/mlflow.container.d/version.conf
#     [Container]
#     Image=ghcr.io/freva-org/freva-mlflow:X.Y.Z
Image=ghcr.io/freva-org/freva-mlflow:latest
ContainerName=mlflow
Network=mlflow.network

# Only nginx on this host may reach MLflow.
PublishPort=127.0.0.1:8080:8080

EnvironmentFile=/etc/mlflow/mlflow.env
# Inside the container MLflow has to listen on all interfaces, otherwise the
# published port cannot reach it. These win over values in the env file.
Environment=MLFLOW_HOST=0.0.0.0 MLFLOW_PORT=8080
Environment=PYTHONPATH=/opt/mlflow/plugins
Volume=/opt/mlflow/plugins:/opt/mlflow/plugins:ro,Z

# Fetch the image again if the pinned tag was rebuilt on the registry. The
# local image is used when ghcr.io cannot be reached.
Pull=newer

HealthCmd=curl -fsS http://127.0.0.1:8080/health
HealthInterval=30s
# Failed probes don't count while a schema migration may still be running.
HealthStartPeriod=600s
HealthRetries=3
# The unit only counts as started once MLflow answers /health, so a failed
# database migration or a broken configuration fails `systemctl start`.
Notify=healthy

NoNewPrivileges=true


[Service]
Restart=always
# Covers the image pull and, with MLFLOW_AUTO_DB_UPGRADE=true, the schema
# migration that runs before MLflow starts listening.
TimeoutStartSec=600


[Install]
WantedBy=multi-user.target
