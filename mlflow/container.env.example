# Optional host/container settings for freva-mlflow.service.
#
# Install as:
#   /etc/mlflow/container.env

# If unset, the launcher prefers Podman and falls back to Docker.
# CONTAINER_RUNTIME=podman
# CONTAINER_RUNTIME=docker

MLFLOW_IMAGE=ghcr.io/freva-org/freva-mlflow:latest
MLFLOW_CONTAINER_NAME=freva-mlflow
MLFLOW_ENV_FILE=/etc/mlflow/mlflow.env

MLFLOW_CONTAINER_NETWORK=mlflow
