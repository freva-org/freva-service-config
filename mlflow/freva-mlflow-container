#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

IMAGE="${MLFLOW_IMAGE:-ghcr.io/freva-org/freva-mlflow:latest}"
NAME="${MLFLOW_CONTAINER_NAME:-freva-mlflow}"
ENV_FILE="${MLFLOW_ENV_FILE:-/etc/mlflow/mlflow.env}"
NETWORK="${MLFLOW_CONTAINER_NETWORK:-host}"

detect_runtime() {
    if [[ -n "${CONTAINER_RUNTIME:-}" ]]; then
        if ! command -v "${CONTAINER_RUNTIME}" >/dev/null 2>&1; then
            echo "ERROR: configured container runtime '${CONTAINER_RUNTIME}' was not found" >&2
            exit 1
        fi
        printf '%s\n' "${CONTAINER_RUNTIME}"
        return
    fi

    if command -v podman >/dev/null 2>&1; then
        printf '%s\n' podman
        return
    fi

    if command -v docker >/dev/null 2>&1; then
        printf '%s\n' docker
        return
    fi

    echo "ERROR: neither podman nor docker was found" >&2
    exit 1
}

runtime="$(detect_runtime)"

require_env_file() {
    if [[ ! -r "${ENV_FILE}" ]]; then
        echo "ERROR: MLflow env file is not readable: ${ENV_FILE}" >&2
        exit 1
    fi
}

case "${1:-}" in
    pull)
        echo "Pulling ${IMAGE} with ${runtime}"
        if ! "${runtime}" pull "${IMAGE}"; then
            if "${runtime}" image inspect "${IMAGE}" >/dev/null 2>&1; then
                echo "WARNING: pull failed; using existing local image ${IMAGE}" >&2
            else
                echo "ERROR: pull failed and no local image exists" >&2
                exit 1
            fi
        fi
        ;;

    remove)
        "${runtime}" rm -f "${NAME}" >/dev/null 2>&1 || true
        ;;

    run)
        require_env_file

        echo "Starting ${NAME}"
        echo "  runtime: ${runtime}"
        echo "  image:   ${IMAGE}"
        echo "  network: ${NETWORK}"
        echo "  env:     ${ENV_FILE}"

        exec "${runtime}" run \
            --rm \
            --name "${NAME}" \
            --network "${NETWORK}" \
            --env-file "${ENV_FILE}" \
            "${IMAGE}"
        ;;

    stop)
        "${runtime}" stop --time 30 "${NAME}" >/dev/null 2>&1 || true
        ;;

    *)
        echo "Usage: $0 {pull|remove|run|stop}" >&2
        exit 2
        ;;
esac
