# Overrides for the integration test, applied on top of ../mlflow.env.example
# (run.sh passes both with --env-file, later files win). Everything not set
# here therefore runs with the production example settings.
#
# Host names are the network aliases of the containers started by run.sh.

MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=8080
MLFLOW_WORKERS=2
MLFLOW_SERVER_ALLOWED_HOSTS=mlflow,mlflow:8080,localhost,localhost:8080
MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=http://mlflow:8080

MLFLOW_BACKEND_STORE_URI=postgresql+psycopg://mlflow:mlflow@postgres:5432/mlflow
OIDC_USERS_DB_URI=postgresql+psycopg://mlflow_auth:mlflow_auth@postgres:5432/mlflow_auth
# Production setting: a version that needs a migration must refuse to start.
# run.sh detects that and runs the migration itself.
MLFLOW_AUTO_DB_UPGRADE=false

# The freva realm from keycloak/import/realm-export.json; its public client
# "freva" has direct access grants enabled.
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/freva/.well-known/openid-configuration
OIDC_CLIENT_ID=freva
OIDC_CLIENT_SECRET=public-client-no-secret
OIDC_REDIRECT_URI=http://localhost:8080/callback
OIDC_VERIFY_SSL=false

# Groups claim and audience are added to the realm by keycloak-setup.sh.
OIDC_GROUPS_ATTRIBUTE=mlflow_roles
OIDC_GROUP_NAME=hpc-user
OIDC_ADMIN_GROUP_NAME=mlflow-admin

# Bearer tokens straight from Keycloak, the only way to log in without a
# browser. Provisioning requires both issuer and audience to be pinned.
OIDC_ISSUER=http://keycloak:8080/realms/freva
OIDC_AUDIENCE=freva
OIDC_PROVISION_ON_BEARER_AUTH=true
# The one deliberate difference from production: the admin user of the test
# can only become admin through the group claim of its token.
OIDC_TRUST_BEARER_GROUP_CLAIMS=true

SECRET_KEY=ci-only-secret-key-not-used-anywhere-else

MLFLOW_ARTIFACTS_DESTINATION=s3://mlflow-artifacts
MLFLOW_S3_ENDPOINT_URL=http://s3:7070
MLFLOW_BOTO_CLIENT_ADDRESSING_STYLE=path
AWS_ACCESS_KEY_ID=ci-access-key
AWS_SECRET_ACCESS_KEY=ci-secret-key
AWS_DEFAULT_REGION=eu-dkrz-0
