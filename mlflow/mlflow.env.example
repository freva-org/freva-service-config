# Freva MLflow application configuration.
#
# Install as:
#   /etc/mlflow/mlflow.env
#
# This file contains credentials and other secrets. Restrict access accordingly:
#   chmod 600 /etc/mlflow/mlflow.env
#
# The supplied systemd deployment passes this file to the MLflow container via
# --env-file. Changes therefore require a container/service restart:
#
#   systemctl restart freva-mlflow


###############################################################################
# MLflow server
###############################################################################

# Address and port on which MLflow listens inside the container.
#
# The supplied deployment uses host networking and expects nginx to run on the
# same host. Binding to loopback therefore prevents clients from bypassing nginx.
MLFLOW_HOST=127.0.0.1
MLFLOW_PORT=8080

# Number of MLflow web-server workers.
#
# Increase this for concurrent API/UI traffic. Each worker is a separate process,
# so increasing this also increases memory usage.
MLFLOW_WORKERS=4

# Hosts accepted by MLflow's Host-header validation.
#
# Set this to the externally visible hostname. Add additional names only when
# clients genuinely access the service through them.
MLFLOW_SERVER_ALLOWED_HOSTS=mlflow.example.com
MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=https://mlflow.example.com

###############################################################################
# PostgreSQL
###############################################################################

# Main MLflow metadata database.
#
# Stores experiments, runs, parameters, metrics, registered models, workspace
# metadata, etc. Large artifacts themselves are stored separately in S3.
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg://mlflow:password@db.example.com:5432/mlflow?sslmode=require

# Database used by mlflow-oidc-auth.
#
# Stores users, groups, permissions, identity bindings, sessions and related
# authentication/authorization metadata.
OIDC_USERS_DB_URI=postgresql+psycopg://mlflow:password@db.example.com:5432/mlflow_auth?sslmode=require

# Optional deployment-specific behaviour implemented by the Freva MLflow image.
#
# When enabled, "mlflow db upgrade" is run for the MLflow metadata database when
# the container starts. For production systems it can be preferable to perform
# schema upgrades explicitly during deployment.
MLFLOW_AUTO_DB_UPGRADE=false


###############################################################################
# OIDC provider / Keycloak
###############################################################################

# OpenID Connect discovery document.
#
# For Keycloak:
#   https://keycloak.example.com/realms/<realm>/.well-known/openid-configuration
OIDC_DISCOVERY_URL=https://keycloak.example.com/realms/example/.well-known/openid-configuration

# Confidential OIDC client used by MLflow.
OIDC_CLIENT_ID=mlflow
OIDC_CLIENT_SECRET=replace-me

# Browser callback registered as a valid redirect URI on the OIDC client.
#
# This must use the externally visible HTTPS URL when nginx terminates TLS.
OIDC_REDIRECT_URI=https://mlflow.example.com/callback

# Verify the TLS certificate of the OIDC provider.
#
# Keep this enabled. Install the appropriate CA certificate instead of disabling
# verification when using an internal certificate authority.
OIDC_VERIFY_SSL=true

# Human-readable label shown for the OIDC provider.
OIDC_PROVIDER_DISPLAY_NAME=Sign in with your account

# Skip the intermediate mlflow-oidc-auth login page when there is only one
# identity provider and immediately redirect users to the OIDC provider.
AUTOMATIC_LOGIN_REDIRECT=true

# Use PKCE for the browser authorization-code flow.
OIDC_CODE_CHALLENGE=S256


###############################################################################
# OIDC identity mapping
###############################################################################

# Claim containing the groups/roles used by MLflow authorization.
#
# It is often useful to create a dedicated flat claim such as "mlflow_roles"
# instead of exposing the complete LDAP/Keycloak group hierarchy directly.
OIDC_GROUPS_ATTRIBUTE=mlflow_roles

# Membership required to use MLflow.
#
# Users without this value in OIDC_GROUPS_ATTRIBUTE are denied login.
OIDC_GROUP_NAME=hpc-user

# Membership that grants global MLflow administrator privileges.
#
# Use an application-specific role rather than a generic role such as "admin".
OIDC_ADMIN_GROUP_NAME=mlflow-admin

# Claims used to derive the persistent MLflow username, in preference order.
#
# preferred_username is normally preferable to email because it remains a short,
# stable login identifier.
OIDC_USERNAME_FIELD=preferred_username,email

# Claims used for the human-readable name shown in the UI.
OIDC_DISPLAY_NAME_FIELD=name,preferred_username


###############################################################################
# OIDC sessions and HTTP behaviour
###############################################################################

# Do not persist OIDC refresh tokens by default.
#
# Enabling this can provide longer-lived browser sessions, but refresh tokens may
# be stored in the application session and therefore deserve additional security
# consideration.
OIDC_USE_REFRESH_TOKEN=false

# Small clock-skew allowance when evaluating OIDC session expiry.
OIDC_SESSION_EXPIRY_LEEWAY_SECONDS=30

# Timeout for HTTP calls to the OIDC provider, in seconds.
OIDC_HTTP_TIMEOUT_SECONDS=10

# Cache the provider's JWKS signing keys to avoid fetching them for every token.
OIDC_JWKS_CACHE_TTL_SECONDS=300


###############################################################################
# Optional: Keycloak bearer-token authentication
###############################################################################

# These settings are only required when API/CLI clients should authenticate
# directly with Keycloak-issued bearer tokens.
#
# The recommended user workflow for this deployment is instead:
#
#   1. Sign in to MLflow through Keycloak.
#   2. Create an MLflow access token in the user profile.
#   3. Configure the pipeline with:
#
#        MLFLOW_TRACKING_USERNAME=<login-name>
#        MLFLOW_TRACKING_PASSWORD=<generated-access-token>
#
# This reuses the user's permissions already synchronized during interactive
# OIDC login.
#
# OIDC_ISSUER=https://keycloak.example.com/realms/example
# OIDC_AUDIENCE=mlflow
# OIDC_PROVISION_ON_BEARER_AUTH=true
# OIDC_TRUST_BEARER_GROUP_CLAIMS=false

###############################################################################
# Application secret and reverse proxy
###############################################################################

# Secret used for signing application/session data.
#
# Generate a long random value, for example:
#   openssl rand -hex 32
#
# This value MUST remain stable across restarts and MUST be identical on every
# replica when running multiple MLflow instances.
SECRET_KEY=replace-with-a-long-random-secret


###############################################################################
# Authorization defaults
###############################################################################

# Permission assigned when no explicit user/group/regex/workspace permission
# matches.
#
# NO_PERMISSIONS is the safest default for a multi-user installation.
DEFAULT_MLFLOW_PERMISSION=NO_PERMISSIONS

# Order in which explicit permission sources are evaluated.
#
# This becomes relevant if the same resource matches several user/group/regex
# rules.
PERMISSION_SOURCE_ORDER=user,group,regex,group-regex

# Restrict creation of resources when authorization does not permit it.
#
# This is particularly useful together with NO_PERMISSIONS and workspaces.
RESTRICT_RESOURCE_CREATION=true

# Start ownership enforcement in reporting mode.
#
# "report" records ownership inconsistencies without immediately rejecting
# operations. This is a useful migration/observation mode before using stricter
# enforcement.
MANAGED_BY_ENFORCEMENT=report


###############################################################################
# Workspaces
###############################################################################

# Enable MLflow workspaces.
#
# Workspaces isolate experiments, models, webhooks and other resources between
# projects while users/groups themselves remain global.
MLFLOW_ENABLE_WORKSPACES=true

# Optional Python module that derives workspaces from the authenticated user's
# OIDC access token.
#
# The module must be importable inside the container and provide:
#
#   get_user_workspaces(access_token) -> list[str]
#
# For example:
#
#   OIDC_WORKSPACE_DETECTION_PLUGIN=dkrz_workspaces
#
# If mounted from the host, ensure its directory is included in PYTHONPATH by
# the container launcher.
# OIDC_WORKSPACE_DETECTION_PLUGIN=my_workspace_plugin

# Permission automatically assigned to workspaces detected during OIDC login.
#
# MANAGE is currently required when ordinary project members must be able to
# create experiments and registered models within their workspace.
OIDC_WORKSPACE_DEFAULT_PERMISSION=MANAGE

# Require a workspace context when non-admin users create workspace-aware
# resources. This prevents accidental creation outside the intended project.
OIDC_WORKSPACE_REQUIRE_CREATION_CONTEXT=true

# Prevent non-admin users from creating resources in the implicit "default"
# workspace, including requests that omit workspace context.
OIDC_WORKSPACE_DENY_DEFAULT_CREATION=true

# Optional claim-based workspace discovery can be used instead of a detection
# plugin when the OIDC provider already emits a clean list of workspace names.
#
# OIDC_WORKSPACE_CLAIM_NAME=workspace


###############################################################################
# Permission and application caches
###############################################################################

# Cache backend for permission/auth lookups.
#
# "local" is appropriate for a single MLflow instance. For multiple replicas,
# use a shared Redis cache so authorization state is consistent between workers
# and hosts.
CACHE_BACKEND=local

# Number of seconds resolved permissions remain cached.
PERMISSION_CACHE_TTL_SECONDS=30

# Redis settings can be configured here when CACHE_BACKEND is switched to the
# Redis backend supported by mlflow-oidc-auth.
#
# Consult the mlflow-oidc-auth configuration reference for the exact Redis
# variables supported by the image version in use.


###############################################################################
# Optional MLflow / OIDC features
###############################################################################

# Disable interactive API documentation on the public deployment.
ENABLE_API_DOCS=false

# Disable MLflow GenAI Gateway integration when it is not used.
OIDC_GEN_AI_GATEWAY_ENABLED=false

# Application logging verbosity.
#
# Common values: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Logger used by the ASGI server.
LOGGING_LOGGER_NAME=uvicorn


###############################################################################
# S3 / S3-compatible artifact storage
###############################################################################

# Root location for MLflow artifacts.
#
# With artifact proxying enabled on the MLflow server, clients upload/download
# artifacts through MLflow and therefore do not need direct S3 credentials.
MLFLOW_ARTIFACTS_DESTINATION=s3://my-bucket/mlflow

# Leave unset for AWS S3.
#
# Set this for VersityGW, MinIO, Ceph RGW or another S3-compatible endpoint.
#
# Do not include whitespace after '='.
# MLFLOW_S3_ENDPOINT_URL=https://s3.example.com
MLFLOW_BOTO_CLIENT_ADDRESSING_STYLE=path

# Credentials used by the MLflow server to access the artifact bucket.
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Set when required by the S3 implementation.
# AWS_DEFAULT_REGION=us-east-1

# Prefer installing/trusting the correct CA certificate over disabling TLS
# verification.
#
# If AWS_CA_BUNDLE is used, the referenced file must also be available inside
# the MLflow container.
#
# AWS_CA_BUNDLE=/etc/ssl/certs/internal-ca-bundle.pem
