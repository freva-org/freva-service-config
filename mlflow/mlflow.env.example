# Freva MLflow application configuration.
#
# Install as:
#   /etc/mlflow/mlflow.env
#
# Recommended permissions:
#   chmod 600 /etc/mlflow/mlflow.env

###############################################################################
# Server
###############################################################################

# The supplied systemd deployment uses --network host and nginx on the same
# machine, so bind only to loopback.
MLFLOW_HOST=127.0.0.1
MLFLOW_PORT=8080
MLFLOW_WORKERS=4

# Replace with the externally visible hostname.
MLFLOW_SERVER_ALLOWED_HOSTS=mlflow.example.org

# Logical multi-user separation.
MLFLOW_ENABLE_WORKSPACES=true

###############################################################################
# PostgreSQL
###############################################################################

MLFLOW_BACKEND_STORE_URI=postgresql+psycopg://mlflow:CHANGE_ME@db.example.org:5432/mlflow
OIDC_USERS_DB_URI=postgresql+psycopg://mlflow_auth:CHANGE_ME@db.example.org:5432/mlflow_auth

###############################################################################
# Keycloak / OIDC
###############################################################################

OIDC_DISCOVERY_URL=https://keycloak.example.org/realms/example/.well-known/openid-configuration
OIDC_CLIENT_ID=mlflow
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_REDIRECT_URI=https://mlflow.example.org/callback

OIDC_GROUPS_ATTRIBUTE=groups
OIDC_GROUP_NAME=mlflow
OIDC_ADMIN_GROUP_NAME=mlflow-admin

# Recommended when accepting Keycloak bearer tokens from API/CLI clients.
OIDC_ISSUER=https://keycloak.example.org/realms/example
OIDC_AUDIENCE=mlflow
OIDC_PROVISION_ON_BEARER_AUTH=true

# Must be stable across restarts and across all replicas.
SECRET_KEY=CHANGE_ME

# nginx is on the same host in the supplied deployment.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

###############################################################################
# S3 / S3-compatible artifact storage
###############################################################################

MLFLOW_ARTIFACTS_DESTINATION=s3://mlflow-artifacts

# Leave unset/commented for normal AWS S3.
# Set this for VersityGW, MinIO or another S3-compatible service.
MLFLOW_S3_ENDPOINT_URL=https://s3.example.org

AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=us-east-1

# Prefer a proper CA bundle over disabling TLS verification.
# If you use AWS_CA_BUNDLE, the referenced path must also exist inside the
# container.
# AWS_CA_BUNDLE=/etc/ssl/certs/internal-ca-bundle.pem
